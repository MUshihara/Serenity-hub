local function isRagdolled()
local c = character()
local h = humanoid()
if not c or not h then
return false
end
return c:GetAttribute("Ragdolled") == true
or h.PlatformStand == true
or h:GetState() == Enum.HumanoidStateType.Physics
end
local function antiRagdollRecover()
if not CONFIG.ANTI_RAGDOLL then
return
end
local deadline =
os.clock()
+ CONFIG.ANTI_RAGDOLL_HOLD
R.RagdollRecoverUntil =
math.max(
R.RagdollRecoverUntil or 0,
deadline
)
task.spawn(function()
