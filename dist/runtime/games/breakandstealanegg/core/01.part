local FILE_LOGGING = type(writefile) == "function"
if FILE_LOGGING then
pcall(writefile, LOG_FILE, "")
end
-- =========================================================
-- Logging
-- =========================================================
local buffer = {}
local bufferBytes = 0
local function flush()
if #buffer == 0 then
return
end
local data = table.concat(buffer)
table.clear(buffer)
bufferBytes = 0
if not FILE_LOGGING then
return
end
if type(appendfile) == "function" then
pcall(appendfile, LOG_FILE, data)
else
local old = ""
if type(readfile) == "function"
and type(isfile) == "function"
and isfile(LOG_FILE) then
local ok, result = pcall(readfile, LOG_FILE)
if ok and type(result) == "string" then
old = result
end
end
pcall(writefile, LOG_FILE, old .. data)
end
end
local function elapsed()
return os.clock() - R.Started
end
local function log(...)
local p = table.pack(...)
for i = 1, p.n do
p[i] = tostring(p[i])
end
local line =
string.format("[%.3f] ", elapsed())
.. table.concat(p, " ")
.. "\n"
buffer[#buffer + 1] = line
bufferBytes += #line
if bufferBytes >= 12000 then
flush()
end
end
local function section(name)
log("")
log("============================================================")
log("[" .. name .. "]")
log("============================================================")
end
local function setState(name)
R.State = name
if R.LastLoggedState ~= name then
R.LastLoggedState = name
log("STATE", name)
flush()
end
end
local function safeName(inst)
if typeof(inst) ~= "Instance" then
return tostring(inst)
end
local ok, result = pcall(function()
return inst:GetFullName()
end)
return ok and result or ("<" .. inst.ClassName .. ":" .. inst.Name .. ">")
end
local function attrs(inst)
if typeof(inst) ~= "Instance" then
return "{}"
end
local ok, a = pcall(inst.GetAttributes, inst)
if not ok or type(a) ~= "table" then
return "{}"
end
local out = {}
for k, v in pairs(a) do
out[#out + 1] = tostring(k) .. "=" .. tostring(v)
end
table.sort(out)
return "{" .. table.concat(out, ",") .. "}"
end
local function connect(signal, fn)
local ok, connection = pcall(function()
return signal:Connect(fn)
end)
if ok and connection then
R.Connections[#R.Connections + 1] = connection
end
return connection
end
-- =========================================================
-- Character helpers
-- =========================================================
local function character()
return LP.Character
end
local function humanoid()
local c = character()
return c and c:FindFirstChildOfClass("Humanoid")
end
local function root()
local c = character()
return c and c:FindFirstChild("HumanoidRootPart")
end
local function waitCharacter()
local deadline = os.clock() + 10
while R.Active and os.clock() < deadline do
local c = character()
local h = humanoid()
local r = root()
if c and h and r then
return c, h, r
end
task.wait(0.1)
end
return nil
end
local function positionOf(inst)
if typeof(inst) ~= "Instance" then
return nil
end
if inst:IsA("BasePart") then
return inst.Position
end
if inst:IsA("Model") then
local ok, cf = pcall(inst.GetPivot, inst)
if ok then
return cf.Position
end
end
local p = inst:FindFirstChildWhichIsA("BasePart", true)
return p and p.Position or nil
end
local function distanceTo(inst)
local r = root()
local p = positionOf(inst)
if not r or not p then
return math.huge
end
return (r.Position - p).Magnitude
end
local function teleportNear(inst, distance)
local r = root()
local p = positionOf(inst)
if not r or not p then
return false
end
distance = distance or 3
local current = r.Position
local flat = Vector3.new(
current.X - p.X,
0,
current.Z - p.Z
)
if flat.Magnitude < 0.1 then
flat = Vector3.new(0, 0, 1)
end
local targetPos =
p
+ flat.Unit * distance
+ Vector3.new(0, 2.2, 0)
local cf = CFrame.lookAt(
targetPos,
Vector3.new(p.X, targetPos.Y, p.Z)
)
pcall(function()
r.AssemblyLinearVelocity = Vector3.zero
r.AssemblyAngularVelocity = Vector3.zero
r.CFrame = cf
end)
task.wait(CONFIG.TELEPORT_SETTLE)
return true
end
